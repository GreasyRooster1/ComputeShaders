#version 430

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding=0) buffer Pos{
    vec4 Position[];
};
layout(std430, binding=1) buffer Vel{
    vec4 Velocity[];
};

const float deltaTime = 0.00006;
const float maxDist = 10.0;

const float particleMass = 0.1;
const float inverseParticleMass = 1.0/particleMass;

vec3 blackHolePos = vec3(0,0,0);
float blackHoleMass = 1000.0;


void main() {
    uint idx = gl_GlobalInvocationID.x;
    vec3 pos = Position[idx].xyz;
    vec3 vel = Velocity[idx].xyz;

    vec3 d = blackHolePos-pos;
    float dist = length(d);
    vec3 force = (blackHoleMass/dist)*normalize(d);

    vec3 a = force*inverseParticleMass;

    //Position[idx].xyz = pos+vec3(0.001);
    Position[idx] = vec4(pos+vel * deltaTime + 0.5 *a * deltaTime*deltaTime,1.0);
    Velocity[idx] = vec4(vel+a*deltaTime,0.0);
}